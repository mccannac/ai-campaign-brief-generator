            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Learnings Entry": {
      "main": [
        [
          {
            "node": "Notify Creative Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Capture Review Notes": {
      "main": [
        [
          {
            "node": "Log Rejection as Learning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Rejection as Learning": {
      "main": [
        [
          {
            "node": "Notify Requester of Revision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}